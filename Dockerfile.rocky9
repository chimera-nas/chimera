# Global scope, ahead of every FROM: an ARG reaches a FROM line only if it is
# declared before the first FROM.  Below one it belongs to that stage instead
# and the prefix expands to empty, sending the pull to Docker Hub unmirrored.
ARG DOCKER_MIRROR=""

# Current ccache, mirrored into GHCR by .github/workflows/mirror-ccache.yml.
# CI overrides CCACHE_REGISTRY to the internal pull-through proxy so an image
# build never reaches out to ghcr.io -- the same public-default/internal-override
# split the KVM guest images use (see kvm/CMakeLists.txt).
#
# Not the distro package: CCACHE_REMOTE_STORAGE arrived in ccache 4.7, and
# rocky9 and ubuntu22 ship 4.6, which reads the pre-rename name and so silently
# ignored the shared cache -- those cells compiled everything cold, every run.
# One pinned upstream binary everywhere retires that whole class of skew.
# quint IS in this image, but without its Rust evaluator.  That evaluator is
# published only as *-unknown-linux-gnu built against glibc 2.39, newer than
# this distro's, so it loads and then dies the first time a generator runs:
#   quint_evaluator: /lib/.../libc.so.6: version `GLIBC_2.39' not found
# and there is no musl build upstream to mirror instead.
#
# This image used to carry no quint at all, which was tolerable only while a
# prebuilt trace bundle existed: the model-based suites replayed a corpus
# generated elsewhere.  The corpus is now generated from ext/specs' models plus
# this repo's configs on every build (cmake/Specs.cmake), so "no quint" would
# have meant "no model-based tests on this cell" -- the merge queue's oldest
# glibc, silently covering less than the others.
#
# Generation therefore runs quint's TypeScript backend everywhere
# (SPECS_QUINT_BACKEND, defaulted in ext/specs/cmake/SpecsCorpus.cmake).  It is
# slower than the Rust one on the large families and walks differently for the
# same seed, so the corpus is a different -- equally valid -- set of traces.
# Both costs were accepted so that every platform generates and replays.

ARG QUINT_REGISTRY=ghcr.io/chimera-nas/quint
ARG QUINT_VERSION=0.32.0
ARG CCACHE_REGISTRY=ghcr.io/chimera-nas/ccache
ARG CCACHE_VERSION=4.14
FROM ${QUINT_REGISTRY}:${QUINT_VERSION} AS quint
FROM ${CCACHE_REGISTRY}:${CCACHE_VERSION} AS ccache

FROM ${DOCKER_MIRROR}rockylinux/rockylinux:9
ARG ENABLE_XLIO=1
ARG ENABLE_FIO=0

# The mirrored ccache, ahead of anything the distro might provide on PATH.
COPY --from=ccache /ccache /usr/local/bin/ccache

# node + quint, from the mirrored toolchain image.  Generation runs quint's
# TYPESCRIPT simulator backend here, not the Rust one: the Rust evaluator is
# published only as *-unknown-linux-gnu built against glibc 2.39, newer than
# this distro's, so it loads and then dies with
#   quint_evaluator: /lib/.../libc.so.6: version `GLIBC_2.39' not found
# and there is no musl build upstream to mirror.  ext/specs/tools/gen.js
# defaults to the typescript backend for exactly this reason (SPECS_QUINT_BACKEND
# selects it), which is what lets this image generate its own trace corpus --
# there is no prebuilt bundle any more, so an image without a working backend
# would run no model-based tests at all.  The warmed Rust evaluator is
# deliberately NOT copied: it would not run.
COPY --from=quint /opt/quint /opt/quint
ENV PATH=/opt/quint/bin:${PATH}

RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb

RUN dnf -y update && \
    dnf -y --allowerasing install gcc gcc-c++ clang clang-tools-extra cmake ninja-build git flex bison llvm \
    libuuid-devel uthash-devel krb5-devel krb5-libs \
    rdma-core-devel jansson-devel xxhash-devel userspace-rcu-devel liburing-devel libunwind-devel libasan \
    rocksdb-devel openssl-devel openssl numactl-devel libcurl-devel libaio-devel libxcrypt-devel \
    autoconf automake libtool pkgconfig ca-certificates uncrustify clang-analyzer iproute curl libnl3-devel \
    libwbclient-devel samba-client krb5-server krb5-workstation samba samba-winbind samba-winbind-clients \
    python3-boto3 which && \
    dnf clean all
# --disable-native below: see .devcontainer/Dockerfile for why fio must not be
# tuned to the runner that happens to build this image.

RUN if [ "$ENABLE_FIO" = "1" ] ; then \
    git clone --depth 1 --branch fio-3.40 https://github.com/axboe/fio.git /fio && \
    cd /fio && \
    ./configure --disable-libnfs --disable-native && \
    make -j8 && \
    make install ; \
    fi

RUN if [ "$ENABLE_XLIO" = "1" ] ; then \
    git clone --depth 1 https://github.com/Mellanox/libdpcp.git /libdpcp && \
    cd /libdpcp && \
    ./autogen.sh && \
    ./configure && \
    make -j8 && \
    make install && \
    git clone --depth 1 --branch 3.60.2-nlfix https://github.com/benjarvis/libxlio.git /libxlio && \
    cd /libxlio && \
    ./autogen.sh && \
    ./configure --with-dpcp=/usr/local && \
    make -j8 && \
    make install ; \
    fi

