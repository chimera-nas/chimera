    "/connections": {
      "get": {
        "summary": "List connections",
        "operationId": "getConnections",
        "tags": [
          "Inspection"
        ],
        "description": "The connections the server holds, copied by the worker thread that owns each one. Filters are ANDed. At most 1,024 rows are returned, shared evenly between the workers asked (`worker_id` gives one worker the whole budget), and a collection that cannot cover every worker, or hits the row limit, says so in `complete`, `truncated` and `missing_workers`. Only one collection runs at a time. There is no pagination and no history of closed connections.",
        "parameters": [
          {
            "name": "worker_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Only the connections owned by this worker thread."
          },
          {
            "name": "service",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "nfs",
                "mount",
                "nlm",
                "nsm",
                "rpcbind"
              ]
            },
            "description": "One service. Without it only nfs is listed; the mount, lock, status and portmap listeners are selected by name."
          },
          {
            "name": "remote_ip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Peer IPv4 or IPv6 address, numeric."
          },
          {
            "name": "remote_port",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "description": "Peer port."
          },
          {
            "name": "local_ip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Local IPv4 or IPv6 address, numeric."
          },
          {
            "name": "local_port",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "description": "Local port."
          },
          {
            "name": "transport",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "tcp",
                "udp",
                "rdma",
                "unix",
                "inproc",
                "fabric"
              ]
            },
            "description": "Transport."
          }
        ],
        "responses": {
          "200": {
            "description": "A complete or explicitly partial answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionsSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "An unknown, repeated, empty or malformed filter, or a worker that does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "429": {
            "description": "Another collection is still outstanding.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds before retrying."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No worker responded, or the server is shutting down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
